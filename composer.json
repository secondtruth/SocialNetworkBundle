{
    "name": "secondtruth/social-network-bundle",
    "type": "symfony-bundle",
    "description": "A Social Network Bundle for Symfony",
    "keywords": ["social network"],
    "license": "GPL",
    "authors": [
        {
            "name": "Vincent GUERARD",
            "email": "v.guerard@fulgurio.net"
        },
        {
            "name": "Grégory Planchat",
            "email": "gregory@kiboko.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/mailer": "^6.4|^7.0",
        "friendsofsymfony/user-bundle": "dev-master",
        "stof/doctrine-extensions-bundle": "^1.10",
        "symfony/twig-bridge": "^6.4|^7.0",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/persistence": "^3.0",
        "doctrine/orm": "^2.17|^3.0",
        "symfony/validator": "^6.4|^7.0",
        "symfony/form": "^6.4|^7.0",
        "symfony/mime": "^6.4|^7.0"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Kiboko\\Bundle\\SocialNetworkBundle\\": "src/Bundle/SocialNetworkBundle/",
            "Kiboko\\Component\\SocialNetwork\\": "src/Component/SocialNetwork/",
            "Akeneo\\Component\\FileStorage\\": "src/Component/FileStorage/"
        }
    }
}
